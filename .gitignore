# 构建产物
/target

# 规范数据集（由 tools/datasets/build.py 生成，体积大，不进 git）
/data/*/
!/data/.gitkeep

# 运行记录（体积随查询数增长；报告里的结论进 docs 或 README）
/results/*/
!/results/.gitkeep

# Python 工具的本地环境
/tools/*/.venv/
/tools/*/.cache/
__pycache__/
*.pyc
.pytest_cache/
# 评测中间 JSON
/results/*.json

# 权重工件与二进制文件严禁入库（统一在魔搭社区托管）
*.bin
/data/*/artifacts/
